export PROJECT_NAME="poc_pgbackrest"
export INSTANCE_ID=$(pwd | shasum -a 1 | awk '{print $1}' | cut -c 1-12) # Used to define docker volume path
export COMPOSE_PROJECT_NAME=${PROJECT_NAME}_${INSTANCE_ID}

export MC_HOST_pgbackrest=https://minioadmin:minioadmin@127.0.0.1:443
export MC_INSECURE=1

if test -f "./terraform-backblaze/.envrc"; then
    source ./terraform-backblaze/.envrc
fi

if test -f "./deploy-on-scaleway/.envrc"; then
    source ./deploy-on-scaleway/.envrc
fi
